<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.sdg13ver5.ShareController"
      spacing="12" prefWidth="500">
    <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <FontIcon iconLiteral="fth-share-2" iconSize="20"/>
        <Label styleClass="share-title" text="Share this page"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="urlField" styleClass="share-url" editable="false" HBox.hgrow="ALWAYS"/>
        <Button styleClass="button, accent-primary" text="Copy" onAction="#copyToClipboard">
            <graphic><FontIcon iconLiteral="fth-copy" iconColor="white"/></graphic>
        </Button>
    </HBox>

    <Label fx:id="successLabel" styleClass="share-success" text=""/>
</VBox>
