<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.sdg13ver5.AdminEditorController"
      spacing="16">
    <padding><Insets top="28" right="40" bottom="28" left="40"/></padding>

    <HBox spacing="14" alignment="CENTER_LEFT">
        <FontIcon fx:id="topicIcon" iconLiteral="fth-book-open" iconSize="28"/>
        <VBox spacing="2">
            <Label fx:id="topicTitle" styleClass="card-heading" text="Topic"/>
            <Label fx:id="topicSub" styleClass="muted" text="Edit the content shown to users."/>
        </VBox>
    </HBox>

    <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT">
            <Label text="Body text (max 300 characters)"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="charCounter" styleClass="char-counter" text="0 / 300"/>
        </HBox>
        <TextArea fx:id="infoArea" wrapText="true" VBox.vgrow="ALWAYS" prefRowCount="14"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="saveStatus" text=""/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Discard" onAction="#discard"/>
            <Button styleClass="button, accent-primary" text="Save changes" onAction="#save">
                <graphic><FontIcon iconLiteral="fth-save" iconColor="white"/></graphic>
            </Button>
        </HBox>
    </VBox>
</VBox>
