<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<GridPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
          fx:controller="com.example.sdg13ver5.AdminLoginController"
          styleClass="auth-shell">
    <columnConstraints>
        <javafx.scene.layout.ColumnConstraints percentWidth="42"/>
        <javafx.scene.layout.ColumnConstraints percentWidth="58"/>
    </columnConstraints>
    <rowConstraints>
        <javafx.scene.layout.RowConstraints vgrow="ALWAYS"/>
    </rowConstraints>

    <VBox styleClass="auth-brand" spacing="20" GridPane.columnIndex="0" GridPane.rowIndex="0">
        <FontIcon iconLiteral="fth-shield" iconSize="72" iconColor="white"/>
        <Label styleClass="auth-brand-title" text="Admin Portal"/>
        <Label styleClass="auth-brand-tagline"
               text="Manage topic content served to end users. All changes take effect immediately."
               wrapText="true"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Label styleClass="auth-brand-tagline" text="Restricted — authorized personnel only"/>
    </VBox>

    <VBox styleClass="auth-form" GridPane.columnIndex="1" GridPane.rowIndex="0" alignment="CENTER_LEFT">
        <padding><Insets top="60" right="60" bottom="60" left="60"/></padding>

        <Label styleClass="auth-heading" text="Admin sign-in"/>
        <Label styleClass="auth-sub" text="Enter the administrator password to continue."/>

        <Region prefHeight="18"/>

        <Label text="Password"/>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <PasswordField fx:id="password" promptText="Admin password" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="passwordVisible" promptText="Admin password" HBox.hgrow="ALWAYS"
                       managed="false" visible="false"/>
            <Button fx:id="togglePasswordBtn" styleClass="icon-button" onAction="#togglePassword">
                <graphic><FontIcon fx:id="togglePasswordIcon" iconLiteral="fth-eye"/></graphic>
            </Button>
        </HBox>

        <Label fx:id="errorLabel" styleClass="field-error" text=""/>

        <Region prefHeight="10"/>

        <Button styleClass="button, accent-primary" text="Sign in as admin" onAction="#login" maxWidth="Infinity"/>
        <Button styleClass="button" text="Back to user login" onAction="#back" maxWidth="Infinity"/>
    </VBox>
</GridPane>
