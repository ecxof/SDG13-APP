<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.sdg13ver5.QuizController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
    <content>
        <VBox spacing="20">
            <padding><Insets top="28" right="48" bottom="48" left="48"/></padding>

            <HBox spacing="14" alignment="CENTER_LEFT">
                <FontIcon fx:id="topicIcon" iconLiteral="fth-help-circle" iconSize="30"/>
                <VBox>
                    <Label fx:id="titleLabel" styleClass="card-heading" text="Quiz"/>
                    <Label fx:id="subLabel" styleClass="muted" text="Test your understanding."/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Back to topic" onAction="#back">
                    <graphic><FontIcon iconLiteral="fth-arrow-left"/></graphic>
                </Button>
            </HBox>

            <VBox fx:id="questionsBox" styleClass="card" spacing="18"/>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="resultLabel" text=""/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="retryBtn" text="Retry" onAction="#retry" visible="false" managed="false"/>
                <Button fx:id="submitBtn" styleClass="button, accent-primary" text="Submit answers" onAction="#submit">
                    <graphic><FontIcon iconLiteral="fth-check" iconColor="white"/></graphic>
                </Button>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
